# Sao chép thành .env.local và điền giá trị thật.

# Địa chỉ backend thật. Mọi request /api/* của app được proxy nguyên path tới đây
# (ví dụ /api/runs?page=1 → ${BACKEND_URL}/api/runs?page=1). Bắt buộc: thiếu biến này
# thì mọi /api/* trả 503 BACKEND_NOT_CONFIGURED. Xem api.md.
BACKEND_URL=http://localhost:8000

# API key của nhà cung cấp mô hình (OpenAI, Anthropic, ...) chỉ đặt ở backend, KHÔNG đặt ở app này.
